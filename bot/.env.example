# Copy this file to .env (never commit .env) and fill it in.
# On Railway, put the same names in the service's Variables tab instead.

# PostgreSQL connection. On Railway use the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/railway
# Set to true when connecting to Railway's database from your laptop (its public URL)
DATABASE_SSL=false

# Make these once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional
# CHAIN=local                      # watch your Anvil instead of Sepolia
# SITE_URL=https://kiyu-production.up.railway.app/
# ALLOWED_ORIGINS=https://kiyu-production.up.railway.app,http://localhost:5173
